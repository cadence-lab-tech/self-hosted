# One entry point for the UI, the REST API, MCP and webhooks. The UI and the
# API share one origin: the browser needs no CORS, agents and the CLI need no
# second address.
#
# Two modes, picked by CADENCE_MODE in .env:
#
#   tls    Caddy serves SDLC_DOMAIN over HTTPS and obtains the certificate
#          from Let's Encrypt itself (ports 80 and 443, compose.tls.yml).
#   proxy  plain HTTP on port 80 inside the container, published on
#          CADENCE_HTTP_ADDR (compose.proxy.yml); TLS is the job of your
#          reverse proxy. No certificates, no ACME.
# Which proxies Caddy believes about the client's address and scheme
# (X-Forwarded-For, X-Forwarded-Proto). A snippet must be defined before the
# line that imports it, so these two stand above the global options.
#
# tls    nobody to trust: Caddy is the edge, it overwrites the headers.
# proxy  your reverse proxy sits in front of Caddy. Without trust Caddy
#        replaces its X-Forwarded-Proto with its own "http", and the API would
#        build the public address (the issuer of the sign-in of MCP clients,
#        docs/admin.md, "Sign-in of MCP clients (OAuth)") on http. With trust
#        the header of a proxy at a private address (loopback, 10/8,
#        172.16/12, 192.168/16, fd00::/8) goes through. A proxy at a public
#        address is not trusted: set SDLC_PUBLIC_URL then.
(trust-tls) {
}

(trust-proxy) {
	servers {
		trusted_proxies static private_ranges
	}
}

{
	# Global options must come first, and the block must exist: without it
	# Caddy would read the imported site block at the bottom as global
	# options. Let in-flight requests (MCP streams) finish on reload.
	grace_period 10s
	import trust-{$CADENCE_MODE:tls}
}

# The routes are the same in both modes.
(routes) {
	encode zstd gzip

	# What the service handles: /v1 is REST, /mcp is agents (the address of
	# the instance, /mcp, and of a project, /mcp/projects/<KEY>), /webhooks
	# is GitHub, /healthz and /readyz are probes, and the two documents under
	# /.well-known/oauth-* are the metadata of the sign-in of MCP clients
	# (RFC 8414, RFC 9728). Only those two: the rest of /.well-known is the
	# UI. Everything else is the UI. /mcp without a slash is a path of its
	# own, /mcp/* does not catch it.
	@backend path /v1/* /mcp /mcp/* /webhooks/* /healthz /readyz /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @backend {
		# MCP answers with a stream (SSE): buffering the response would
		# break it.
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# The UI image serves its own static files and falls back to index.html:
	# routes such as /projects/ACME/tasks/42 live in the browser router. It
	# listens on 8080 only since v0.16.0 (on 80 and 8080 in v0.14.x and
	# v0.15.x, so this route works with their images too).
	handle {
		reverse_proxy ui:8080
	}
}

(mode-tls) {
	{$SDLC_DOMAIN} {
		# Let's Encrypt writes here when renewal starts failing.
		tls {$ACME_EMAIL}
		import routes
	}
}

(mode-proxy) {
	http:// {
		import routes
	}
}

import mode-{$CADENCE_MODE:tls}
